{
  "files.exclude": {
    "**/__pycache__": true,
    ".*cache*": true,
    ".*coverage*": true,
  },
  "editor.scrollbar.verticalScrollbarSize": 0.3,
  "editor.scrollbar.vertical": "visible",
  "files.associations": {
    "*.json": "json",
    "*.py": "python"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.unusedImports": "explicit"
    },
  },
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "editor.defaultFormatter": "charliermarsh.ruff",
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "cSpell.words": [
    "CHEBI",
    "CHEMINF",
    "CHMO",
    "EMBL",
    "ENVO",
    "exposomics",
    "fluxomics",
    "HMDB",
    "importlinter",
    "lipidomics",
    "Metabolomics",
    "MS",
    "MSIO",
    "MTBLS",
    "NCBITAXON",
    "NCIT",
    "OMICS",
    "ORCID",
    "PMID",
    "pubmed",
    "REFMET",
    "sdrf",
    "setuptools",
    "SNOMED",
    "UBERON",
    "untargeted",
    "venv"
  ],
}

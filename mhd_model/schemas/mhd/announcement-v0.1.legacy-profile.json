{
  "id": "https://metabolomicshub.github.io/mhd-model/schemas/v1_0/announcement-v1.0.legacy-profile.json",
  "extends": "https://metabolomicshub.github.io/mhd-model/schemas/v1_0/announcement-v1.0.base-profile.json",
  "version": "v1.0",
  "name": "MetabolomicsHub Announcement File v1.0 Legacy Profile",
  "description": "MetabolomicsHub Announcement File v1.0 Legacy Profile",
  "configuration": {
    "cv_term_field_mapping": {
      "label_field": "source",
      "accession_field": "accession",
      "name_field": "name",
      "value_field": "value"
    }
  },
  "requirements": {
    "$": {
      "enforcement_level": "required",
      "requirements": [
        {
          "code": "legacy-required-0001",
          "enforcement_level": "required",
          "required_properties": [
            "id",
            "$schema",
            "profile_uri",
            "type",
            "uri",
            "mhd_metadata_file_url",
            "cv_definitions",
            "repository_name",
            "repository_short_name",
            "repository_identifier",
            "license",
            "url_list",
            "name",
            "description",
            "submission_date",
            "public_release_date",
            "submitters",
            "repository_metadata_file_list"
          ],
          "recommended_properties": [
            "principal_investigators",
            "characteristic_values",
            "protocols",
            "submitter_keywords",
            "raw_data_file_list",
            "result_file_list",
            "reported_molecular_entities"
          ]
        }
      ]
    },
    "$.url_list": {
      "code": "legacy-url-list-0001",
      "enforcement_level": "required",
      "value_constraint": {
        "type": "items-count",
        "min_occurs": 1
      }
    },
    "$.repository_name": {
      "code": "legacy-repository_name-0001",
      "enforcement_level": "required",
      "value_constraint": {
        "type": "string-length",
        "minimum": 1
      }
    },
    "$.repository_short_name": {
      "code": "legacy-repository_short_name-0001",
      "enforcement_level": "required",
      "value_constraint": {
        "type": "string-length",
        "minimum": 1
      }
    },
    "$.repository_identifier": {
      "code": "legacy-repository_identifier-0001",
      "enforcement_level": "required",
      "value_constraint": {
        "type": "string-length",
        "minimum": 1
      }
    },
    "$.license_name": {
      "code": "legacy-license-name-0001",
      "enforcement_level": "required",
      "value_constraint": {
        "type": "string-length",
        "minimum": 1
      }
    },
    "$.name": {
      "code": "legacy-name-0001",
      "enforcement_level": "required",
      "value_constraint": {
        "type": "string-length",
        "minimum": 0
      }
    },
    "$.description": {
      "code": "legacy-description-0001",
      "enforcement_level": "required",
      "value_constraint": {
        "type": "string-length"
      }
    },
    "$.submitters": {
      "code": "legacy-submitters-0001",
      "enforcement_level": "required",
      "value_constraint": {
        "type": "items-count",
        "min_occurs": 1
      }
    },
    "$.submitters[*].email_list": {
      "code": "legacy-submitters_emails-0001",
      "enforcement_level": "required",
      "value_constraint": {
        "type": "items-count",
        "min_occurs": 1
      }
    },
    "$.principal_investigators": {
      "code": "legacy-principal_investigators-0001",
      "enforcement_level": "required",
      "value_constraint": {
        "type": "items-count",
        "min_occurs": 1
      }
    },
    "$.principal_investigators[*].email_list": {
      "code": "legacy-principal_investigators-email_list_0001",
      "enforcement_level": "required",
      "value_constraint": {
        "type": "items-count",
        "min_occurs": 1
      }
    },
    "$.characteristic_values": {
      "enforcement_level": "required",
      "requirements": [
        {
          "code": "legacy-characteristic_values-0001",
          "enforcement_level": "required",
          "value_constraint": {
            "type": "items-count",
            "description": "There must be a characteristic named 'Organism' in characteristic_values",
            "item_value_jsonpath_list": [
              ".[*].key"
            ],
            "item_value_match_constraint": {
              "type": "cv-term-enum",
              "allowed_cv_terms": [
                {
                  "cv_label": "NCIT",
                  "cv_accession": "NCIT:C14250",
                  "name": "Organism"
                }
              ]
            },
            "min_referenced_value_match": 1,
            "max_referenced_value_match": 1
          }
        }
      ]
    }
  }
}

{
  "$defs": {
    "AnnouncementContact": {
      "description": "A contact person associated with the dataset.\nThis can be a submitter, author, or a principal investigator.",
      "properties": {
        "full_name": {
          "anyOf": [
            {
              "minLength": 5,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Full name of the contact person.",
          "title": "Full Name"
        },
        "email_list": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of contact email addresses.",
          "title": "Email List"
        },
        "orcid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ORCID digital identifier of the contact person.",
          "title": "ORCID"
        },
        "affiliation_list": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of institutional affiliations for the contact.",
          "title": "Affiliation List"
        }
      },
      "title": "AnnouncementContact",
      "type": "object"
    },
    "AnnouncementDerivedDataFile": {
      "description": "Derived or processed data file generated from raw data analysis.",
      "properties": {
        "name": {
          "description": "Name of the file including extension.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url_list": {
          "description": "List of direct download or access URLs for the file.",
          "items": {
            "format": "uri",
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Url List",
          "type": "array"
        },
        "compression_formats": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CvTerm"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of compression format CV terms applied to the file (e.g. gzip, zip).",
          "title": "Compression Formats"
        },
        "extension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "File extension string (e.g., .mzML, .raw, .txt).",
          "title": "Extension"
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/CvTerm"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Format of the derived data file as a CV term.",
          "title": "Format"
        }
      },
      "required": [
        "name",
        "url_list"
      ],
      "title": "AnnouncementDerivedDataFile",
      "type": "object"
    },
